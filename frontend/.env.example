# Browser-safe Supabase project settings. The publishable/anon key is protected by RLS.
VITE_SUPABASE_URL=https://frjczezgdxxkgftkovgo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Site URL (public, no secrets)
VITE_SITE_URL=https://os-resource-monitoring.example.com

# Copy this file to .env.local and add the publishable key from Supabase Project Settings → API.
# Never put a service-role/secret key or any API key in a VITE_* variable or frontend code.
# API keys (including the provided platform key) must remain server-side only.
